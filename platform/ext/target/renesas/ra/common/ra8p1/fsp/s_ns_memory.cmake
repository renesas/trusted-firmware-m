# Helper: expand one window into its CPU0_N partition cache variables.
function(_ra_define_n_window _prefix _start _end)
    math(EXPR _size "${_end} - ${_start}" OUTPUT_FORMAT HEXADECIMAL)
    set(${_prefix}_CPU0_N_START "${_start}" CACHE STRING "Default: from RA_NS_WINDOW_STARTS (${_start})")
    set(${_prefix}_CPU0_N_SIZE "${_size}" CACHE STRING "Default: from RA_NS_WINDOW_STARTS (${_size})")
endfunction()

if(DEFINED RA_NS_WINDOW_STARTS)
