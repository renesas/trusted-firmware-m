# FSP post config for RA8P1. Included by fsp_s_lib.cmake and
# fsp_ns_lib.cmake after s_ns_{memory,interrupt,peripheral}.cmake in this directory,
# which hold only settings. All derived values and the compile definitions
# exported on fsp_library_config (PRIVATE to the fsp_library sources) are computed
# here. Nothing is exported to platform_region_defs: TF-M's region_defs.h and
# flash_layout.h use only TF-M-level values from config.cmake / post_config.cmake.

#==================== Partition settings for bsp_linker_info.h ================#
# Veneer region MUST be allocated at end of secure image partition
math(EXPR _VENEER_START "${S_ROM_ALIAS_BASE} + ${FLASH_S_PARTITION_SIZE} - ${FLASH_CPU0_C_SIZE}")
set(FLASH_CPU0_C_START "${_VENEER_START}" CACHE STRING "CMSE veneer region base in MRAM (NSC)" FORCE)

if(DEFINED S_RAM_ALIAS_BASE)
    # Values are available (this file is being included from the S-side
    # CMakeLists.txt, after config.cmake has run).
    set(RAM_CPU0_S_START ${S_RAM_ALIAS_BASE})
    # The NSC carve-out (RAM_CPU0_C_SIZE) is excluded from the secure RAM
    # partition so the FSP BSP's SAU secure region does not overlap it;
    # RAM_CPU0_C_SIZE itself is declared in s_ns_memory.cmake.
    math(EXPR RAM_CPU0_S_SIZE "${S_DATA_SIZE} - ${RAM_CPU0_C_SIZE}")
    math(EXPR RAM_NS_CPU0_N_START "${CPU0_NS_RAM_ALIAS_BASE} + ${CPU0_NS_RAM_OFFSET}")
    set(RAM_NS_CPU0_N_SIZE ${CPU0_NS_RAM_DATA_SIZE})
else()
    # Exceptional: config.cmake has not run (or its map was not exported to
    # the NS build). These hardcoded values silently diverge from the
    # config.cmake defaults if those change -- warn so it shows in build logs.
    message(WARNING "RA8P1: fsp_post_config.cmake using hardcoded CPU0 RAM fallback values (S_RAM_ALIAS_BASE not defined); keep in sync with config.cmake")
    set(RAM_CPU0_S_START "0x22000000")
    set(RAM_CPU0_S_SIZE "0x80000")
    set(RAM_NS_CPU0_N_START "0x32080000")
    set(RAM_NS_CPU0_N_SIZE "0x80000")
endif()

if(DEFINED S_ROM_ALIAS_BASE)
    set(FLASH_CPU0_S_START ${S_ROM_ALIAS_BASE})
    math(EXPR FLASH_CPU0_S_SIZE "${FLASH_S_PARTITION_SIZE} + ${FLASH_STORAGE_TOTAL_SIZE}")
    math(EXPR FLASH_NS_CPU0_N_START "${CPU0_NS_ROM_ALIAS_BASE} + ${CPU0_NS_IMAGE_PRIMARY_PARTITION_OFFSET}")
    set(FLASH_NS_CPU0_N_SIZE ${FLASH_CPU0_NS_PARTITION_SIZE})
else()
    # Exceptional: see the CPU0 RAM fallback above.
    message(WARNING "RA8P1: fsp_post_config.cmake using hardcoded CPU0 FLASH fallback values (S_ROM_ALIAS_BASE not defined); keep in sync with config.cmake")
    set(FLASH_CPU0_S_START "0x02000000")
    set(FLASH_CPU0_S_SIZE "0x60000")
    set(FLASH_NS_CPU0_N_START "0x12060000")
    set(FLASH_NS_CPU0_N_SIZE "0x60000")
endif()

# CPU1 image/data partitions, derived from config.cmake's CPU1 map.
if(DEFINED CPU1_NS_ROM_ALIAS_BASE)
    math(EXPR _CPU1_FLASH_START "${CPU1_NS_ROM_ALIAS_BASE} + ${CPU1_NS_IMAGE_PRIMARY_PARTITION_OFFSET}")
    math(EXPR _CPU1_RAM_START "${CPU1_NS_RAM_ALIAS_BASE} + ${CPU1_NS_RAM_OFFSET}")
    set(FLASH_NS_CPU1_N_START "${_CPU1_FLASH_START}")
    set(FLASH_NS_CPU1_N_SIZE "${FLASH_CPU1_NS_PARTITION_SIZE}")
    set(RAM_NS_CPU1_N_START "${_CPU1_RAM_START}")
    set(RAM_NS_CPU1_N_SIZE "${CPU1_NS_RAM_DATA_SIZE}")
else()
    message(WARNING "RA8P1: fsp_post_config.cmake using hardcoded CPU1 fallback values (CPU1_NS_ROM_ALIAS_BASE not defined); keep in sync with config.cmake")
    set(FLASH_NS_CPU1_N_START "0x0")
    set(FLASH_NS_CPU1_N_SIZE "0x0")
    set(RAM_NS_CPU1_N_START "0x0")
    set(RAM_NS_CPU1_N_SIZE "0x0")
endif()

# Secure extension is disabled for CPU1 (see bsp_linker_info.h), so its secure
# partitions are empty, placed right after the CPU0 secure partitions. Only
# consumed by the partition data file (tfm_s.rpd), not by the FSP sources.
math(EXPR RAM_CPU1_S_START "${RAM_CPU0_S_START} + ${RAM_CPU0_S_SIZE} + ${RAM_CPU0_C_SIZE}")
set(RAM_CPU1_S_SIZE "0x0")
math(EXPR FLASH_CPU1_S_START "${FLASH_CPU0_S_START} + ${FLASH_CPU0_S_SIZE}")
set(FLASH_CPU1_S_SIZE "0x0")

# ---- Non-secure external windows (OSPI0/1 CS0/CS1, SDRAM) --------------------
# The *_CPU0_N_* partition bases are the non-secure external address windows,
# single-sourced from RA_NS_WINDOW_STARTS/ENDS (config.cmake, also consumed by
# check_config.cmake to validate off-chip image placement).

# Helper: expand one window into its CPU0_N partition variables (fixed hardware facts, not cache).
function(_ra_define_n_window _prefix _start _end)
    math(EXPR _size "${_end} - ${_start}" OUTPUT_FORMAT HEXADECIMAL)
    set(${_prefix}_CPU0_N_START "${_start}" PARENT_SCOPE)
    set(${_prefix}_CPU0_N_SIZE "${_size}" PARENT_SCOPE)
endfunction()

if(DEFINED RA_NS_WINDOW_STARTS)
    # Window order matches config.cmake: OSPI0 CS0, OSPI0 CS1, OSPI1 CS0,
    # OSPI1 CS1, SDRAM.
    list(GET RA_NS_WINDOW_STARTS 0 _ra_win0_start)
    list(GET RA_NS_WINDOW_ENDS 0 _ra_win0_end)
    list(GET RA_NS_WINDOW_STARTS 1 _ra_win1_start)
    list(GET RA_NS_WINDOW_ENDS 1 _ra_win1_end)
    list(GET RA_NS_WINDOW_STARTS 2 _ra_win2_start)
    list(GET RA_NS_WINDOW_ENDS 2 _ra_win2_end)
    list(GET RA_NS_WINDOW_STARTS 3 _ra_win3_start)
    list(GET RA_NS_WINDOW_ENDS 3 _ra_win3_end)
    list(GET RA_NS_WINDOW_STARTS 4 _ra_win4_start)
    list(GET RA_NS_WINDOW_ENDS 4 _ra_win4_end)

    _ra_define_n_window(OSPI0_CS0 "${_ra_win0_start}" "${_ra_win0_end}")
    _ra_define_n_window(OSPI0_CS1 "${_ra_win1_start}" "${_ra_win1_end}")
    _ra_define_n_window(OSPI1_CS0 "${_ra_win2_start}" "${_ra_win2_end}")
    _ra_define_n_window(OSPI1_CS1 "${_ra_win3_start}" "${_ra_win3_end}")
    _ra_define_n_window(SDRAM "${_ra_win4_start}" "${_ra_win4_end}")
else()
    # Fallback for contexts without config.cmake (kept in sync with the
    # RA_NS_WINDOW_STARTS/ENDS defaults in config.cmake).
    set(SDRAM_CPU0_N_START "0x6c000000")
    set(SDRAM_CPU0_N_SIZE "0x2000000")
    set(OSPI0_CS0_CPU0_N_START "0x88000000")
    set(OSPI0_CS0_CPU0_N_SIZE "0x4000000")
    set(OSPI0_CS1_CPU0_N_START "0x98000000")
    set(OSPI0_CS1_CPU0_N_SIZE "0x4000000")
    set(OSPI1_CS0_CPU0_N_START "0x74000000")
    set(OSPI1_CS0_CPU0_N_SIZE "0x2000000")
    set(OSPI1_CS1_CPU0_N_START "0x7c000000")
    set(OSPI1_CS1_CPU0_N_SIZE "0x2000000")
endif()

