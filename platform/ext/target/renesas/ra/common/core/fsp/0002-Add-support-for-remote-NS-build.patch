+++ b/ra/fsp/src/bsp/mcu/all/bsp_irq.c
@@ -202,7 +202,9 @@ void R_BSP_IrqCfgEnable (IRQn_Type const irq, uint32_t priority, void * p_contex
 
 /** @} (end addtogroup BSP_MCU) */
 
-#if (BSP_CFG_CPU_CORE == 1) && !BSP_TZ_NONSECURE_BUILD
+/* TODO: INTSELR must be set from the Secure state. Need to confirm and, if necessary, add support for
+ * setting it from the CPU0 Secure side when CPU1 runs with Security Extension disabled. */
+#if (BSP_CFG_CPU_CORE == 1) && !BSP_TZ_NONSECURE_BUILD && !BSP_REMOTE_NONSECURE_BUILD
 
 /*******************************************************************************************************************//**
  * INTSELR is a S-TYPE-6 register but it needs to be set based on interrupts that are used in each project.
@@ -287,7 +289,8 @@ void bsp_irq_cfg (void)
  #endif
 #endif
 #if BSP_FEATURE_ICU_HAS_IELSR
-
+/* The TF-M implementation will set the IELSR and INTSELR registers. */
+ #if !BSP_TZ_NONSECURE_BUILD && !BSP_REMOTE_NONSECURE_BUILD
     /* Calculate the number of IELSR registers that need to be initialized. */
     uint32_t ielsr_count = BSP_ICU_VECTOR_MAX_ENTRIES - BSP_FEATURE_ICU_FIXED_IELSR_COUNT;
     if (ielsr_count > BSP_ICU_VECTOR_NUM_ENTRIES)
@@ -300,11 +303,11 @@ void bsp_irq_cfg (void)
         if (0U != g_interrupt_event_link_select[i])
         {
             R_ICU->IELSR[i] = (uint32_t) g_interrupt_event_link_select[i];
-
  #if (BSP_CFG_CPU_CORE == 1)
             bsp_prv_intselr_set(g_interrupt_event_link_select[i]);
  #endif
         }
     }
+ #endif
 #endif
 }
diff --git a/ra/fsp/src/r_dtc/r_dtc.c b/ra/fsp/src/r_dtc/r_dtc.c
index ff22d67c5..fa232c811 100644
--- a/ra/fsp/src/r_dtc/r_dtc.c
+++ b/ra/fsp/src/r_dtc/r_dtc.c
@@ -259,7 +259,7 @@ fsp_err_t R_DTC_Reset (transfer_ctrl_t * const p_api_ctrl,
 
     /* Disable read skip prior to modifying settings. It will be enabled later
      * (See "Transfer Information Read Skip Function" in the DTC section of the relevant hardware manual). */
-#if !BSP_TZ_NONSECURE_BUILD && BSP_FEATURE_TZ_HAS_TRUSTZONE
+#if !BSP_TZ_NONSECURE_BUILD && !BSP_REMOTE_NONSECURE_BUILD && BSP_FEATURE_TZ_HAS_TRUSTZONE
     R_DTC->DTCCR_SEC = DTC_PRV_RRS_DISABLE;
 #else
     R_DTC->DTCCR = DTC_PRV_RRS_DISABLE;
@@ -290,7 +290,7 @@ fsp_err_t R_DTC_Reset (transfer_ctrl_t * const p_api_ctrl,
     }
 
     /* Enable read skip after all settings are written. */
-#if !BSP_TZ_NONSECURE_BUILD && BSP_FEATURE_TZ_HAS_TRUSTZONE
+#if !BSP_TZ_NONSECURE_BUILD && !BSP_REMOTE_NONSECURE_BUILD && BSP_FEATURE_TZ_HAS_TRUSTZONE
     R_DTC->DTCCR_SEC = DTC_PRV_RRS_ENABLE;
 #else
     R_DTC->DTCCR = DTC_PRV_RRS_ENABLE;
@@ -546,13 +546,13 @@ static void r_dtc_state_initialize (void)
         memset(&gp_dtc_vector_table, 0U, DTC_VECTOR_TABLE_ENTRIES * sizeof(transfer_info_t *));
 
         /* Set DTC vector table. */
-#if !BSP_TZ_NONSECURE_BUILD && BSP_FEATURE_TZ_HAS_TRUSTZONE
+#if !BSP_TZ_NONSECURE_BUILD && !BSP_REMOTE_NONSECURE_BUILD && BSP_FEATURE_TZ_HAS_TRUSTZONE
         R_DTC->DTCVBR_SEC = (uint32_t) gp_dtc_vector_table;
 #else
         R_DTC->DTCVBR = (uint32_t) gp_dtc_vector_table;
 #endif
 
-#if BSP_FEATURE_TZ_HAS_TRUSTZONE && BSP_TZ_NONSECURE_BUILD
+#if BSP_FEATURE_TZ_HAS_TRUSTZONE && (BSP_TZ_NONSECURE_BUILD || BSP_REMOTE_NONSECURE_BUILD)
         if (1 == DTC_PRV_DTCSAR_DTCSTSA)
         {
             /* Enable the DTC Peripheral */
@@ -577,7 +577,7 @@ static void r_dtc_set_info (dtc_instance_ctrl_t * p_ctrl, transfer_info_t * p_in
 
     /* Disable read skip prior to modifying settings. It will be enabled later
      * (See "Transfer Information Read Skip Function" in the DTC section of the relevant hardware manual). */
-#if !BSP_TZ_NONSECURE_BUILD && BSP_FEATURE_TZ_HAS_TRUSTZONE
+#if !BSP_TZ_NONSECURE_BUILD && !BSP_REMOTE_NONSECURE_BUILD && BSP_FEATURE_TZ_HAS_TRUSTZONE
     R_DTC->DTCCR_SEC = DTC_PRV_RRS_DISABLE;
 #else
     R_DTC->DTCCR = DTC_PRV_RRS_DISABLE;
@@ -587,7 +587,7 @@ static void r_dtc_set_info (dtc_instance_ctrl_t * p_ctrl, transfer_info_t * p_in
     gp_dtc_vector_table[p_ctrl->irq] = p_info;
 
     /* Enable read skip after all settings are written. */
-#if !BSP_TZ_NONSECURE_BUILD && BSP_FEATURE_TZ_HAS_TRUSTZONE
+#if !BSP_TZ_NONSECURE_BUILD && !BSP_REMOTE_NONSECURE_BUILD && BSP_FEATURE_TZ_HAS_TRUSTZONE
     R_DTC->DTCCR_SEC = DTC_PRV_RRS_ENABLE;
 #else
     R_DTC->DTCCR = DTC_PRV_RRS_ENABLE;
