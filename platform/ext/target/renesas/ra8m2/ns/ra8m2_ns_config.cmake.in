#
# Port-specific configuration handed from the SPE build to the NSPE build.
#
# Generated: configure_file() fills this in from the SPE build's values. Edit
# ns/ra8m2_ns_config.cmake.in, not the copy in the installed tree.
#
# TF-M's cmake/spe_config.cmake carries the standard options (partitions, MCUBOOT_ALIGN_VAL,
# CONFIG_TFM_USE_TRUSTZONE, ...), but it is generated from an upstream template with no place
# for a platform's own settings. Both sides must agree on the values below, so they are
# carried rather than decided again.
#-------------------------------------------------------------------------------

# Console. If the secure side logs over RTT and the non-secure side is built for UART, the NS
# image pulls in an SCI it does not own, and only the secure side's output appears, which
# reads as "NS never ran".
set(RA8M2_STDOUT_RTT           @RA8M2_STDOUT_RTT@           CACHE BOOL "stdout over SEGGER RTT")
set(RA8M2_RTT_BLOCKING         @RA8M2_RTT_BLOCKING@         CACHE BOOL "RTT blocks rather than dropping output")
set(RA8M2_SPE_CRYPTO_HW_ACCELERATOR @CRYPTO_HW_ACCELERATOR@ CACHE BOOL "SPE built with the SCE9 accelerator")

# The e2 project set the secure side was built against. The NS application needs the
# non-secure project from the same solution: its Debug/memory_regions.ld places the NS image,
# and a mismatch puts it at the wrong address with no build-time complaint.
set(RA8M2_SPE_FSP_NS_APP_DIR   "@FSP_NS_APP_DIR@"           CACHE PATH "FSP NS project the SPE was built against")

# The toolchain. TF-M's toolchain_ns_GNUARM.cmake finds the compiler with
# find_program(${CROSS_COMPILE}-gcc), which needs it on PATH. The SPE was built with an
# explicit path (an e2 studio install is not usually on PATH), so the same prefix is carried
# and both builds use the same GCC for the veneers and the NS objects that link them.
set(RA8M2_SPE_CROSS_COMPILE    "@RA8M2_SPE_CROSS_COMPILE@"  CACHE STRING "Compiler prefix the SPE used")
